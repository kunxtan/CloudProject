# คัดลอกเป็น backend/.env แล้วแก้ค่าตามต้องการ
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=hiwlaewq
DB_PASSWORD=hiwlaewq
DB_NAME=hiwlaewq
# DB_SSL=rds   # เปิดเมื่อต่อ Amazon RDS

JWT_SECRET=dev-secret-please-change-0123456789
JWT_EXPIRES_IN=1d

# วันที่ของคิวและสถิติรายชั่วโมงคิดตามเวลานี้ (ไทย = +07:00)
APP_TZ_OFFSET=+07:00

# local = เก็บรูปในเครื่อง (dev), s3 = Amazon S3 (production)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3_BUCKET=hiwlaewq-uploads-xxxx
# AWS_REGION=ap-southeast-1

# จำนวน proxy ด้านหน้า (production: CloudFront + ALB = 2)
TRUST_PROXY=0
LOG_LEVEL=info
