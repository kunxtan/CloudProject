#!/bin/bash
# สคริปต์นี้รันครั้งเดียวตอน EC2 บูตครั้งแรก (log อยู่ที่ /var/log/cloud-init-output.log)
# ค่า $${...} ถูก Terraform แทนให้ก่อนส่งขึ้นเครื่อง ส่วน $VAR ธรรมดาเป็นตัวแปรของ bash
set -euo pipefail

REGION="${region}"

# 1) ติดตั้ง Docker
dnf install -y docker
systemctl enable --now docker

# 2) อ่านค่าจาก SSM Parameter Store (สิทธิ์มาจาก IAM Role ของเครื่อง)
param() {
  aws ssm get-parameter --region "$REGION" --name "${ssm_prefix}/$1" \
    --with-decryption --query Parameter.Value --output text
}
TAG=$(param image_tag)

IMDS_TOKEN=$(curl -sS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

# 3) เขียน env file (อ่านได้เฉพาะ root) — secrets ไม่โผล่ใน command line
umask 077
cat > /etc/${project}.env <<EOF
NODE_ENV=production
PORT=3000
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_USER=${db_user}
DB_NAME=${db_name}
DB_SSL=rds
DB_PASSWORD=$(param db_password)
JWT_SECRET=$(param jwt_secret)
STORAGE_DRIVER=s3
S3_BUCKET=${uploads_bucket}
AWS_REGION=${region}
TRUST_PROXY=2
EOF

# 4) pull image แล้วรัน (container จะ migrate DB ก่อน start server — ดู backend/Dockerfile)
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${ecr_registry}"
docker pull "${ecr_repo}:$TAG"

docker run -d --name ${project} --restart always \
  -p 3000:3000 \
  --env-file /etc/${project}.env \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  --log-opt awslogs-stream="$INSTANCE_ID" \
  "${ecr_repo}:$TAG"

echo "${project} started with image tag $TAG"
